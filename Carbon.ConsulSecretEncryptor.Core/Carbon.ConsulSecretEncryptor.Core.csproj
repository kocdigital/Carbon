<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0;net10.0</TargetFrameworks>
    <RootNamespace>Carbon.ConsulSecretEncryptor.Core</RootNamespace>
    <AssemblyName>Carbon.ConsulSecretEncryptor.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Description>
      1.0.0
      - Shared certificate resolution and RSA-OAEP/SHA256 + hybrid AES-256-GCM envelope encrypt/decrypt logic
        for Consul secrets (ACL token, Basic Auth, whole-document, field-level), used by both
        Carbon.ConsulSecretEncryptor (CLI), Carbon.ConsulSecretEncryptor.UI (Windows Forms), and now
        Carbon.ConsoleApplication.Extensions / Carbon.WebApplication (no local crypto logic remains there).
    </Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0' or '$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
  </ItemGroup>
</Project>
