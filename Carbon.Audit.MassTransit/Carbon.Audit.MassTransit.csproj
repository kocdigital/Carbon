<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Description>
      MassTransit 8 / RabbitMQ transport for Carbon.Audit. Use Carbon.Audit.MassTransit7 instead
      when the service runs on MassTransit 7.
      1.0.0
      - IAuditBus, AuditBusConfigExtensions and RabbitMqAuditEventPublisher moved here from
        Carbon.Audit 2.0.0, with unchanged namespaces.
      - services.AddCarbonAuditMassTransit(configuration) registers the dedicated audit bus and
        IAuditEventPublisher when "CarbonAudit:Enabled" is true, and does nothing otherwise.
    </Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Carbon.Audit\Carbon.Audit.csproj" />
    <ProjectReference Include="..\Carbon.MassTransit\Carbon.MassTransit.csproj" />
  </ItemGroup>

</Project>
